# Copie ce fichier en .env puis adapte. Les SECRETS ne vont pas ici : ils sont dans ./secrets/ (make secrets).

# Adresse publique exacte de Bank, telle que tu l'ouvres dans le navigateur (HTTPS obligatoire en prod).
BANK_PUBLIC_URL=https://bank.nimbus.lan
# Noms d'hôte acceptés (protection contre le DNS rebinding). Format JSON.
BANK_ALLOWED_HOSTS=["bank.nimbus.lan"]

# Port publié par le conteneur web. 127.0.0.1 = seulement ton reverse proxy local y accède.
BANK_BIND=127.0.0.1
BANK_PORT=8088

# Synchronisation bancaire (Enable Banking, mode restreint gratuit) — laisse vide pour l'import seul.
BANK_ENABLEBANKING_APP_ID=
# Décommente une fois secrets/enablebanking.pem rempli :
# BANK_ENABLEBANKING_KEY_FILE=/run/secrets/enablebanking_key
# Toutes les 8 h (DSP2 : 4 accès automatiques max par jour). 0 = désactivé.
BANK_SYNC_INTERVAL_HOURS=8

# Sécurité des sessions
BANK_SESSION_IDLE_MINUTES=30
BANK_SESSION_ABSOLUTE_HOURS=12
