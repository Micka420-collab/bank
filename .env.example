# Copie ce fichier en .env puis adapte. Les SECRETS ne vont pas ici : ils sont dans ./secrets/ (make secrets).

# Adresse publique exacte de Bank, telle que tu l'ouvres dans le navigateur (HTTPS obligatoire en prod).
BANK_PUBLIC_URL=https://bank.nimbus.lan
# Noms d'hôte acceptés (protection contre le DNS rebinding). Format JSON.
BANK_ALLOWED_HOSTS=["bank.nimbus.lan"]

# Port publié par le conteneur web. 127.0.0.1 = seulement ton reverse proxy local y accède.
BANK_BIND=127.0.0.1
BANK_PORT=8088

# Synchronisation bancaire (Enable Banking, mode restreint gratuit) — laisse vide pour l'import seul.
BANK_ENABLEBANKING_APP_ID=
# Décommente une fois secrets/enablebanking.pem rempli :
# BANK_ENABLEBANKING_KEY_FILE=/run/secrets/enablebanking_key
# Toutes les 8 h (DSP2 : 4 accès automatiques max par jour). 0 = désactivé.
BANK_SYNC_INTERVAL_HOURS=8

# Linky (Conso API) : synchronisation quotidienne en tâche de fond. false la coupe.
BANK_ENERGY_ENABLED=true

# Agents IA (HERMÈS via MCP sur /mcp). false coupe complètement le serveur MCP.
BANK_AGENTS_ENABLED=true
BANK_AGENT_CALLS_PER_MINUTE=120

# Messageries (Telegram, WhatsApp, Signal, Discord, Slack, ntfy) : rien ne tourne tant que tu n'en as pas configuré
# une et donné ton accord dans Bank › Messageries. false les coupe toutes, d'un coup.
BANK_CHANNELS_ENABLED=true
# WhatsApp seulement : adresse publique par laquelle Meta joint le webhook, si BANK_PUBLIC_URL n'est joignable que
# chez toi. Ton reverse proxy n'y ouvre que /api/channels/whatsapp/webhook (docs/CANAUX.md). Ajoute alors ce nom
# à BANK_ALLOWED_HOSTS, ou fais réécrire l'en-tête Host par ton reverse proxy.
# BANK_CHANNELS_PUBLIC_URL=https://bank-webhook.exemple.fr
# Fuseau des heures calmes et du point de la semaine.
BANK_TIMEZONE=Europe/Paris

# Sécurité des sessions
BANK_SESSION_IDLE_MINUTES=30
BANK_SESSION_ABSOLUTE_HOURS=12
