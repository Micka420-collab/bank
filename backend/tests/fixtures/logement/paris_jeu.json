{"visibility": "domain", "fields": [{"name": "annee", "description": null, "annotations": {"disjunctive": true, "sortable": true, "facet": true, "facetsort": "-count"}, "label": "Année", "type": "text"}, {"name": "id_zone", "description": null, "annotations": {"facet": true, "facetsort": "num", "disjunctive": true}, "label": "Secteurs géographiques", "type": "int"}, {"name": "id_quartier", "description": "Numéro de quartier Ville de Paris - C_QU", "annotations": {}, "label": "Numéro du quartier", "type": "int"}], "dataset_id": "logement-encadrement-des-loyers", "dataset_uid": "da_99ue9c", "has_records": true, "features": ["analyze", "geo"], "attachments": [{"id": "annexe_3_plan_d_ensemble_pdf", "title": "Annexe-3-Plan_d_ensemble.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/logement-encadrement-des-loyers/attachments/annexe_3_plan_d_ensemble_pdf"}, {"id": "arrete_prefectoral_encadrement_des_loyers_01_06_2022_publie_pdf", "title": "Arrêté préfectoral encadrement des loyers 01 06 2022 publié.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/logement-encadrement-des-loyers/attachments/arrete_prefectoral_encadrement_des_loyers_01_06_2022_publie_pdf"}, {"id": "arrete_prefectoral_du_7_juin_2021_encadrement_des_loyers_paris_pdf", "title": "arrêté préfectoral du 7 juin 2021 encadrement des loyers Paris.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/logement-encadrement-des-loyers/attachments/arrete_prefectoral_du_7_juin_2021_encadrement_des_loyers_paris_pdf"}, {"id": "arrete_4_juin_2020_encadrement_des_loyers_paris_pdf", "title": "Arrêté 4 juin 2020 encadrement des loyers Paris.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/logement-encadrement-des-loyers/attachments/arrete_4_juin_2020_encadrement_des_loyers_paris_pdf"}, {"id": "arrete_28_mai_2019_encadrement_des_loyers_paris_pdf", "title": "Arrêté 28 mai 2019 encadrement des loyers Paris.pdf", "mimetype": "application/pdf", "url": "https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/logement-encadrement-des-loyers/attachments/arrete_28_mai_2019_encadrement_des_loyers_paris_pdf"}], "alternative_exports": [], "data_visible": true, "metas": {"default": {"title": "Logement - Encadrement des loyers", "description": "<p><b>Ce jeu de données présente les loyers de référence par quartier, depuis la mise en place de l'encadrement des loyers en 2019. Il est mis à jour chaque année le 1er juillet et l'historique des années précédentes est conservé</b><b style=\"font-family: inherit; font-size: 0.875rem;\">.</b></p><p>Cartographie des quartiers de localisation des immeubles, classés par secteurs géographiques et typologie de logement (Nombre de pièces, époque de construction, type de location (meublées, non meublées)), précisant les loyers de référence, les loyers de référence majorés et les loyers de référence minorés, exprimés en euros par mètre carré de surface habitable, sur l’intégralité du territoire de la Ville de Paris.</p><p><a href=\"https://www.paris.fr/encadrementloyers\" target=\"_blank\">L’encadrement des loyers : comment ça marche? Sur Paris.fr</a></p><p>Ce jeu de données correspond au contenu de l'outil mis à disposition sur Paris.fr : <a href=\"https://teleservices.paris.fr/encadrementdesloyers/jsp/site/Portal.jsp?page=check-my-rent\" target=\"_blank\">Encadrement des loyers, vérifiez votre loyer de référence</a>.</p><p>Ce jeu de données repose sur celui des <a href=\"https://parisdata.opendatasoft.com/explore/dataset/quartier_paris/table\" target=\"_blank\">Quartiers administratifs</a></p><p>En pièce jointe à ce jeu de données, vous trouverez les arrêtés annuels.</p><p>La carte interactive et le tableau des loyers de référence de ce jeu de données n'ont qu'une valeur indicative. </p><p>Les références de loyers et les cartes opposables de l'arrêté préfectoral sont accessibles sur <a href=\"https://www.drihl.ile-de-france.developpement-durable.gouv.fr/le-dispositif-d-encadrement-des-loyers-a-paris-a292.html\" target=\"_blank\">le site de la préfecture de la région Ile-de-France</a></p>", "theme": ["Urbanisme et Logements"], "keyword": ["logement", "loyers", "loyer de référence", "DLH"], "license": "Open Database License (ODbL)", "license_url": "http://opendatacommons.org/licenses/odbl/", "language": "fr", "modified": "2025-06-17T15:23:33+00:00", "publisher": "Direction du Logement et de l'Habitat - Ville de Paris", "references": null, "attributions": null, "update_frequency": null, "bbox": {"type": "Feature", "geometry": {"coordinates": [[[2.4697608780115843, 48.90216187108308], [2.2240784112364054, 48.90216187108308], [2.2240784112364054, 48.815576643683016], [2.4697608780115843, 48.815576643683016], [2.4697608780115843, 48.90216187108308]]], "type": "Polygon"}, "properties": {}}, "data_processed": "2025-06-17T15:23:33+00:00", "federated": false, "geographic_reference": ["fr_80_75056"], "geographic_reference_auto": false, "geometry_types": ["Polygon"], "metadata_languages": ["fr"], "metadata_processed": "2025-06-17T15:23:33.784000+00:00", "modified_updates_on_data_change": true, "modified_updates_on_metadata_change": false, "parent_domain": null, "records_count": 17920, "shared_catalog": null, "source_dataset": null, "source_domain": null, "source_domain_address": null, "source_domain_title": null, "territory": ["Paris"], "timezone": null}, "dcat": {"accessRights": null, "accrualperiodicity": "Annuelle", "conforms_to": null, "contact_email": null, "contact_name": null, "contributor": null, "created": "2019-07-08", "creator": null, "dataquality": null, "granularity": null, "issued": null, "publisher_type": null, "relation": null, "spatial": null, "temporal": null, "temporal_coverage_end": null, "temporal_coverage_start": null}}}